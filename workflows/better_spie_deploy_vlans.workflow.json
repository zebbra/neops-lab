{
  "name": "better_spie_deploy_vlans",
  "type": "workflow",
  "label": "better_spie_deploy_vlans",
  "package": "wf.neops.io",
  "majorVersion": 11,
  "minorVersion": 0,
  "patchVersion": 0,
  "seedEntity": "group",
  "runOn": "group",
  "parameters": {},
  "rawParameters": {},
  "acquire": [
    {
      "type": "elastic",
      "entity": "device",
      "query": "hostname: \"netbox.netcreed.ch\"",
      "description": "NetBox Device"
    }
  ],
  "steps": [
    {
      "type": "functionBlock",
      "label": "vlans",
      "functionBlock": "fb.base.neops.io/netbox_get_vlans:0.1.0",
      "runOn": "device",
      "condition": {
        "type": "jmes",
        "jmes": "context.device.hostname == 'netbox.netcreed.ch'"
      },
      "parameters": {
        "site_names": "{{ context.deviceGroups[].name }}"
      },
      "rawParameters": {},
      "acquire": [
        {
          "type": "elastic",
          "entity": "group",
          "query": "name: (Home OR Office OR \"Gillette Stadium\")",
          "description": "Sites to read VLANs for"
        }
      ]
    }
  ]
}
