# =============================================================================
# NeOps Lab - Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment. docker compose
# reads .env automatically; the Makefile greps it (it never sources it).

# -----------------------------------------------------------------------------
# Local Lab Images (optional)
# -----------------------------------------------------------------------------

# A locally-built image (no registry host, e.g. neops-web-client:latest) is not
# pullable: docker resolves it as docker.io/library/... Both paths already
# handle that, so an override here needs no extra flags:
#   * `make local-env-{init,up}` pull with `--ignore-pull-failures`, so the
#     unpullable local tag is warned about instead of aborting the target;
#   * `docker compose up -d` reads `pull_policy: missing` from the compose
#     files and uses the local image without contacting a registry at all.

# Override the web client image used by the local lab stack, e.g. to run a
# locally-built image instead of the published one.
# Defaults to quay.io/zebbra/neops-web-client:develop
# NEOPS_WEB_CLIENT_IMAGE=neops-web-client:latest

# Pin another tag of the developer preview (default `develop`); the image
# override below wins over it.
# NEOPS_ENGINE_TAG=0.42.2-beta.3

# Override the workflow engine image (API only). Defaults to the public
# developer preview; point it at the full licensed engine (needs
# `docker login quay.io`) or at a local build:
# NEOPS_WORKFLOW_ENGINE_IMAGE=quay.io/zebbra/neops-workflow-engine:develop
# NEOPS_WORKFLOW_ENGINE_IMAGE=neops-workflow-engine:latest

# Monitor app image (workflow-engine-client). Defaults to the developer
# preview even when NEOPS_WORKFLOW_ENGINE_IMAGE is the licensed engine —
# that image often has no /app/rest/monitor-app and the client exits.
# NEOPS_MONITOR_IMAGE=quay.io/zebbra/neops-workflow-engine-preview:develop

# Override the CMS image, e.g. to run a locally-built one.
# Defaults to quay.io/zebbra/neops-cms-free:develop
# NEOPS_CMS_IMAGE=neops-cms-free:latest

# Override the worker image. The lab runs the published worker SDK image; point
# this at a locally-built neops-worker-sdk:latest to exercise SDK changes here
# before they are released. `pull_policy: missing` finds the local image and
# skips the registry.
# Defaults to quay.io/zebbra/neops-worker-sdk:develop
# NEOPS_WORKER_SDK_IMAGE=neops-worker-sdk:latest
# TODO: Currently needed because technopark branch is not yet merged
NEOPS_WORKER_SDK_IMAGE=quay.io/zebbra/neops-worker-sdk:0.2.0-beta.3

# -----------------------------------------------------------------------------
# Host mode (optional) — make host-env-init / host-lab-up  (Traefik)
# Host-direct (optional) — make host-direct-env-init       (ports, no Traefik)
# -----------------------------------------------------------------------------
# Single-hostname deployment. Laptop targets (make local-*) ignore these.
# Required for host-* / host-direct-* targets. Point DNS or /etc/hosts at this
# host.
#
# Traefik path prefixes (make host-*):
#   /         -> web client
#   /cms      -> CMS via cms-proxy (admin, GraphQL, file API)
#   /djstatic -> CMS static (Django STATIC_URL)
#   /engine   -> workflow engine REST
#   /monitor  -> monitor app (Vite base /monitor/)
# Also publishes :8080 / :8001 / :3030 / :3031 for direct debug access.
#
# Host-direct (make host-direct-*): same ports as laptop mode, URLs use LAB_HOST
# (http://LAB_HOST:8080 etc.). No Traefik — tear down host-* first.
#
# LAB_HOST=lab.example.com
# Use http for plain :80 only (no TLS, no :443, no HTTPS redirect).
# Default / omit for https (:443 + redirect from :80). Traefik mode only.
# LAB_SCHEME=http
# LAB_SCHEME=https
# Optional Let's Encrypt (HTTPS / Traefik mode only). Leave unset for Traefik's
# default self-signed certificate. When set (usually `letsencrypt`), also set
# TRAEFIK_ACME_EMAIL and ensure LAB_HOST is publicly resolvable — the Makefile
# then loads docker-compose.traefik-acme.yml.
# TRAEFIK_CERTRESOLVER=letsencrypt
# TRAEFIK_ACME_EMAIL=ops@example.com
