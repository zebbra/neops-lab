.pytest_cache/
.cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/
.tox/
.nox/

# Type checking and linting caches
.mypy_cache/
.ruff_cache/
.pytype/

# Virtual environments and local Python runtime
.env
.env.*
!.env.example
.venv
.venv*/
venv/
env/
ENV/
venv.bak/
env.bak/
__pypackages__/
.python-version

