#!/usr/bin/env python3
"""Render the containerlab lab from a scenario's topology (stdlib-only, run on the host).

Writes the containerlab topology + device configs under
`generated/<scenario>/clab/` (git-ignored), the committed
`scenarios/<scenario>/workflow-execution-parameters/*.json` in the topology's
own subnet, and the same parameter files moved into the deployed subnet under
`generated/<scenario>/workflow-execution-parameters/`. Reuses the per-device
renderers from the sibling `gen_device_configs`.

The deployment (lab name, mgmt network and its subnet) comes from LAB_NAME,
LAB_NET and LAB_SUBNET, which the Makefile defaults and exports.
"""

from __future__ import annotations

import argparse
import ipaddress
import json
import os
import sys
from typing import NamedTuple

import labscripts

# Generated parameter files keep their committed names; only the directory they
# live in is per-scenario.
PARAM_FILES = ("discover-params.json", "discover-params-autodetect.json", "discover-params-subnet.json")

# The subnet every scenario's topology.json writes its mgmt_ip values in. A
# deployment in another subnet keeps each device's host offset.
TOPOLOGY_SUBNET = "172.30.0.0/24"


class Deployment(NamedTuple):
    """Where one lab runs: its containerlab name and its mgmt network."""

    name: str
    network: str
    subnet: str


def deployment_from_env() -> Deployment:
    """Read the deployment the Makefile exports; an unset value is an error, not a guess."""
    missing = [key for key in ("LAB_NAME", "LAB_NET", "LAB_SUBNET") if not os.environ.get(key)]
    if missing:
        raise SystemExit(f"set {', '.join(missing)} or drive this through make")
    return Deployment(os.environ["LAB_NAME"], os.environ["LAB_NET"], os.environ["LAB_SUBNET"])


def relocate(devices: dict, subnet: str) -> dict:
    """Return the devices with each mgmt_ip moved from TOPOLOGY_SUBNET into `subnet`."""
    source = ipaddress.ip_network(TOPOLOGY_SUBNET)
    target = ipaddress.ip_network(subnet)
    if target.prefixlen > source.prefixlen:
        raise ValueError(f"LAB_SUBNET {subnet} is smaller than the topology's {TOPOLOGY_SUBNET}")
    moved = {}
    for host, dev in devices.items():
        offset = int(ipaddress.ip_address(dev["mgmt_ip"])) - int(source.network_address)
        moved[host] = {**dev, "mgmt_ip": str(target.network_address + offset)}
    return moved


# Reuse the per-device render helpers from the extension-less sibling module.
gen_device_configs = labscripts.load("gen_device_configs")

# Which files a device is handed at /lab is one decision, made in
# resolve_scenario and shared with the Kubernetes flavour.
LAB_FILE_KEYS = gen_device_configs.resolve_scenario.LAB_FILE_KEYS
LAB_DIR_PATH = gen_device_configs.resolve_scenario.LAB_DIR_PATH

render_frr = gen_device_configs.render_frr
render_srl = gen_device_configs.render_srl
_write = gen_device_configs._write
_prune_stale = gen_device_configs._prune_stale


def scenario_paths(scenario: str) -> dict:
    """Return every path this generator writes for one scenario."""
    return {
        "clab_file": gen_device_configs.resolve_scenario.output_dir(scenario) / "clab" / "neops-lab.clab.json",
        "params": {
            name: gen_device_configs.resolve_scenario.source_dir(scenario) / "workflow-execution-parameters" / name
            for name in PARAM_FILES
        },
        "deployed_params": {
            name: gen_device_configs.resolve_scenario.output_dir(scenario) / "workflow-execution-parameters" / name
            for name in PARAM_FILES
        },
    }


def mgmt_creds(vendor: str) -> tuple[str, str]:
    """Return `(username, password)` for a vendor's management access."""
    if vendor == "frr":
        return ("frr", "frr")
    if vendor == "srl":
        return ("admin", "NokiaSrl1!")
    raise ValueError(f"unknown vendor {vendor!r}")


def clab_iface(vendor: str, name: str) -> str:
    """Map a device interface name to its containerlab netdev name.

    SR Linux `ethernet-1/N` -> `e1-N` (containerlab's linux netdev name, which
    the NOS aliases back to `ethernet-1/N`). FRR names are used as-is (`swp1`).
    """
    if name.startswith("ethernet-"):
        return "e" + name[len("ethernet-") :].replace("/", "-")
    return name


def _peer_iface_to_clab(vendor: str, ref: str) -> str:
    """Convert a peer interface reference to its clab netdev name.

    Handles both the SHORT forms used inside `to` strings (FRR `swpN`, SRL
    `e1/N`) and the full `name` forms (SRL `ethernet-1/N`).
      FRR:  `swp1`         -> `swp1`
      SRL:  `e1/1`         -> `e1-1`
      SRL:  `ethernet-1/1` -> `e1-1`
    """
    if ref.startswith("ethernet-"):
        return "e" + ref[len("ethernet-") :].replace("/", "-")
    if ref.startswith("e") and "/" in ref:
        return ref.replace("/", "-")
    return ref


def parse_endpoint(to: str, devices: dict) -> tuple[str, str] | None:
    """Parse a `to` string into `(host, iface)` if it targets a device.

    Returns `None` for stub/host-facing endpoints:
      * no colon (`"isp-upstream"`, `"server web-01"`)
      * `"<host>:<iface>"` where `<host>` is not a device key
        (e.g. `"cust-a-ce:ge0/0"`).
    """
    if ":" not in to:
        return None
    host, _, iface = to.partition(":")
    if host not in devices:
        return None
    return (host, iface)


def build_links(devices: dict) -> tuple[list, list]:
    """Build `(veth_links, dummy_links)` from the device map.

    Real inter-device links become veth links `{"endpoints": [a, b]}`, deduped
    so a physically shared link (listed on both devices) appears once. Stub /
    host-facing ports become `dummy` links on the owning node.
    """
    veth_links: list = []
    dummy_links: list = []
    seen: set = set()

    for host, dev in devices.items():
        vendor = dev["vendor"]
        for iface in dev["interfaces"]:
            local_ep = f"{host}:{clab_iface(vendor, iface['name'])}"
            parsed = parse_endpoint(iface["to"], devices)
            if parsed is None:
                dummy_links.append(
                    {
                        "type": "dummy",
                        "endpoint": {
                            "node": host,
                            "interface": clab_iface(vendor, iface["name"]),
                        },
                    }
                )
                continue
            peer, peer_iface = parsed
            peer_vendor = devices[peer]["vendor"]
            remote_ep = f"{peer}:{_peer_iface_to_clab(peer_vendor, peer_iface)}"
            key = frozenset({local_ep, remote_ep})
            if key in seen:
                continue
            seen.add(key)
            veth_links.append({"endpoints": [local_ep, remote_ep]})

    return veth_links, dummy_links


def render_clab(devices: dict, deployment: Deployment) -> dict:
    """Render the full containerlab topology document.

    Nodes are prefixed with the lab name, so two labs on one host never share a
    container name.
    """
    nodes: dict = {}
    for host, dev in devices.items():
        vendor = dev["vendor"]
        if vendor == "frr":
            nodes[host] = {
                "kind": "linux",
                "mgmt-ipv4": dev["mgmt_ip"],
                # Relative to the topology file's own directory
                # (generated/<scenario>/clab), which is where containerlab
                # resolves binds from before handing absolute host paths to the
                # daemon — not relative to the repo root.
                "binds": [
                    f"frr/{host}.iface:/etc/frr/lab-interfaces/{host}.iface:ro",
                    *(f"../scenario/devices/frr/{name}:{LAB_DIR_PATH}/{name}:ro" for name in LAB_FILE_KEYS),
                ],
                "exec": [f"sh {LAB_DIR_PATH}/set-aliases.sh"],
            }
        elif vendor == "srl":
            nodes[host] = {
                "kind": "nokia_srlinux",
                "mgmt-ipv4": dev["mgmt_ip"],
                "startup-config": f"srl/{host}.cli",
            }
        else:
            raise ValueError(f"unknown vendor {vendor!r} for {host}")

    veth_links, dummy_links = build_links(devices)

    return {
        "name": deployment.name,
        "prefix": "__lab-name",
        "mgmt": {"network": deployment.network, "ipv4-subnet": deployment.subnet},
        "topology": {
            "kinds": {
                "linux": {"image": "neops-lab-frr:latest"},
                "nokia_srlinux": {"image": "ghcr.io/nokia/srlinux:26.3"},
            },
            "nodes": nodes,
            "links": veth_links + dummy_links,
        },
    }


def render_discover_params(devices: dict) -> dict:
    """Render the discover-params document in device-declaration order.

    A single host is a /32 subnet. Credentials are supplied once as a list
    rather than repeated per subnet. Because these subnets declare their
    platform, each credential is scoped to its vendor's platform, so no host
    is ever tried with the other vendor's login.
    """
    subnets = [{"cidr": f"{dev['mgmt_ip']}/32", "platform": dev["vendor"]} for dev in devices.values()]
    return {"subnets": subnets, "credentials": _credentials(devices, scoped=True)}


def render_autodetect_params(devices: dict) -> dict:
    """Same /32 subnets with `platform` left out, so discovery has to detect it.

    The lab's second discovery scenario: nothing is known about a host but its
    address, which is what a real greenfield scan looks like.
    """
    subnets = [{"cidr": f"{dev['mgmt_ip']}/32"} for dev in devices.values()]
    return {"subnets": subnets, "credentials": _credentials(devices)}


def render_subnet_params(devices: dict, subnet: str = TOPOLOGY_SUBNET) -> dict:
    """One subnet target for the complete lab management network.

    The credentials sit on the subnet here rather than on the document, because
    a wide prefix carries no platform to scope them against.
    """
    return {"subnets": [{"cidr": subnet, "credentials": _credentials(devices)}]}


def _credentials(devices: dict, scoped: bool = False) -> list:
    """One entry per distinct vendor, in device-declaration order.

    ``scoped`` stamps each entry with its vendor's platform; the lab's vendor
    names double as platform short names.
    """
    credentials = []
    for vendor in dict.fromkeys(dev["vendor"] for dev in devices.values()):
        username, password = mgmt_creds(vendor)
        entry = {"username": username, "password": password}
        if scoped:
            entry["platform"] = vendor
        credentials.append(entry)
    return credentials


def _dump_discover_params(data: dict) -> str:
    """Serialize discover-params with the committed compact per-entry layout.

    Each subnet object sits on its own line as `{ "cidr": ..., ... }` with
    spaces inside the braces -- a layout `json.dumps` cannot produce directly.
    """
    lines = ["{", '  "subnets": [']
    subnets = data["subnets"]
    for i, subnet in enumerate(subnets):
        fields = ", ".join(f'"{k}": {json.dumps(v)}' for k, v in subnet.items())
        comma = "," if i < len(subnets) - 1 else ""
        lines.append(f"    {{ {fields} }}{comma}")
    lines.append("  ],")
    lines.append('  "credentials": [')
    creds = data["credentials"]
    for i, cred in enumerate(creds):
        fields = ", ".join(f'"{k}": {json.dumps(v)}' for k, v in cred.items())
        comma = "," if i < len(creds) - 1 else ""
        lines.append(f"    {{ {fields} }}{comma}")
    lines.append("  ]")
    lines.append("}")
    return "\n".join(lines) + "\n"


def _dump_subnet_params(data: dict) -> str:
    return json.dumps(data, indent=2) + "\n"


def _write_params(targets: dict, devices: dict, subnet: str) -> None:
    _write(targets["discover-params.json"], _dump_discover_params(render_discover_params(devices)))
    _write(targets["discover-params-autodetect.json"], _dump_discover_params(render_autodetect_params(devices)))
    _write(targets["discover-params-subnet.json"], _dump_subnet_params(render_subnet_params(devices, subnet)))


def parse_args(argv: list) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Render the containerlab lab for a scenario.")
    parser.add_argument("--scenario", help="scenario to render; defaults to $SCENARIO")
    return parser.parse_args(argv)


def main(argv: list | None = None) -> int:
    args = parse_args(sys.argv[1:] if argv is None else argv)
    scenario = gen_device_configs.resolve_scenario.scenario_name(args.scenario)
    devices = gen_device_configs.load_topology(scenario)
    frr_dir, srl_dir = gen_device_configs.device_dirs(scenario)
    paths = scenario_paths(scenario)

    frr_hosts = set()
    srl_hosts = set()

    for host, dev in devices.items():
        vendor = dev["vendor"]
        if vendor == "frr":
            _write(frr_dir / f"{host}.iface", render_frr(host, dev))
            frr_hosts.add(host)
        elif vendor == "srl":
            _write(srl_dir / f"{host}.cli", render_srl(host, dev))
            srl_hosts.add(host)
        else:
            print(f"unknown vendor {vendor!r} for {host}", file=sys.stderr)
            return 1

    _prune_stale(frr_dir, ".iface", frr_hosts)
    _prune_stale(srl_dir, ".cli", srl_hosts)

    deployment = deployment_from_env()
    deployed = relocate(devices, deployment.subnet)
    clab = render_clab(deployed, deployment)
    _write(paths["clab_file"], json.dumps(clab, indent=2) + "\n")

    _write_params(paths["params"], devices, TOPOLOGY_SUBNET)
    _write_params(paths["deployed_params"], deployed, deployment.subnet)

    veth_count = sum(1 for link in clab["topology"]["links"] if link.get("type") != "dummy")
    dummy_count = sum(1 for link in clab["topology"]["links"] if link.get("type") == "dummy")
    print(
        f"scenario {scenario!r}: {len(clab['topology']['nodes'])} nodes, "
        f"{veth_count} veth links, {dummy_count} dummy links"
    )
    print(f"generated {len(frr_hosts)} FRR + {len(srl_hosts)} SRL device configs")
    print(f"generated {', '.join(PARAM_FILES)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
