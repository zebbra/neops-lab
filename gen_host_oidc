#!/usr/bin/env python3
"""Render cms/oidc-config.host.json from the host-mode template (stdlib-only).

The laptop oidc-config.json stays hard-coded to localhost:8080. Host modes
serve the web client at a LAB_HOST origin, so the noop OIDC authority/redirect
URLs must match that origin or the Angular bootstrap fails with a blank
<app-root>.

Reads from the environment or .env (docker-compose style KEY=VALUE lines):

  LAB_HOST     (required)
  LAB_SCHEME   default https — used when LAB_ACCESS=proxy
  LAB_ACCESS   proxy (default) | direct
               proxy  → origin LAB_SCHEME://LAB_HOST  (Traefik path prefixes)
               direct → origin http://LAB_HOST:8080   (published ports, no TLS)

Writes cms/oidc-config.host.json and monitor/config.host.js (git-ignored).
"""

from __future__ import annotations

import os
import pathlib
import sys

HERE = pathlib.Path(__file__).resolve().parent
TEMPLATE = HERE / "cms" / "oidc-config.host.json.template"
OUTPUT = HERE / "cms" / "oidc-config.host.json"
DOTENV = HERE / ".env"


def _load_dotenv(path: pathlib.Path) -> dict[str, str]:
    """Parse KEY=VALUE lines; ignore comments and blank lines. No shell expansion."""
    if not path.is_file():
        return {}
    values: dict[str, str] = {}
    for raw in path.read_text().splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        key = key.strip()
        value = value.strip().strip("'").strip('"')
        if key:
            values[key] = value
    return values


def main() -> int:
    dotenv = _load_dotenv(DOTENV)
    # Real environment wins over .env so `LAB_HOST=… make host-env-init` works.
    lab_host = os.environ.get("LAB_HOST") or dotenv.get("LAB_HOST", "")
    lab_scheme = os.environ.get("LAB_SCHEME") or dotenv.get("LAB_SCHEME", "https")
    lab_access = (
        os.environ.get("LAB_ACCESS") or dotenv.get("LAB_ACCESS", "proxy")
    ).strip().lower()

    if not lab_host:
        print(
            "error: LAB_HOST is required (set it in .env or the environment).",
            file=sys.stderr,
        )
        return 2
    if lab_scheme not in ("http", "https"):
        print(
            f"error: LAB_SCHEME must be 'http' or 'https', got {lab_scheme!r}.",
            file=sys.stderr,
        )
        return 2
    if lab_access not in ("proxy", "direct"):
        print(
            f"error: LAB_ACCESS must be 'proxy' or 'direct', got {lab_access!r}.",
            file=sys.stderr,
        )
        return 2

    if lab_access == "direct":
        # Published compose ports are plain HTTP regardless of LAB_SCHEME.
        origin = f"http://{lab_host}:8080"
        engine_url = f"http://{lab_host}:3030"
    else:
        origin = f"{lab_scheme}://{lab_host}"
        engine_url = f"{origin}/engine"

    text = TEMPLATE.read_text().replace("{{LAB_ORIGIN}}", origin)
    OUTPUT.write_text(text)
    print(f"wrote {OUTPUT.relative_to(HERE)} (origin {origin}, access {lab_access})")

    # Monitor postMessage origin + engine API must match the public URLs.
    monitor_out = HERE / "monitor" / "config.host.js"
    monitor_out.parent.mkdir(parents=True, exist_ok=True)
    monitor_out.write_text(
        "// Generated by ./gen_host_oidc — do not edit.\n"
        "window.__NEOPS_CONFIG__ = {\n"
        f"  webclientOrigin: {origin!r},\n"
        f"  apiBaseUrl: {engine_url!r}\n"
        "}\n"
    )
    print(f"wrote {monitor_out.relative_to(HERE)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
