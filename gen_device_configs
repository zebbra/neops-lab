#!/usr/bin/env python3
"""Render per-device interface configs from a scenario's topology (stdlib-only).

FRR -> `generated/<scenario>/clab/frr/<host>.iface` (`name|description` per
line); SR Linux -> `generated/<scenario>/clab/srl/<host>.cli`
(`set / interface …` lines).

`load_topology` lives here too: three scripts read the topology, and where that
file is and how it is opened is one fact, not three copies of two lines.
"""

from __future__ import annotations

import argparse
import json
import pathlib
import sys

import labscripts

# Which scenario is selected, where it lives and where its artifacts go is
# `resolve_scenario`'s knowledge, loaded rather than restated here.
resolve_scenario = labscripts.load("resolve_scenario")


def topology_path(scenario: str) -> pathlib.Path:
    """Return a scenario's `topology.json`. Never inherited from the base."""
    return resolve_scenario.source_dir(scenario) / "topology.json"


def load_topology(scenario: str | None = None, path: pathlib.Path | None = None) -> dict:
    """Return the device map for a scenario, or from an explicit topology file."""
    if path is None:
        path = topology_path(resolve_scenario.scenario_name(scenario))
    return json.loads(path.read_text())["devices"]


def device_dirs(scenario: str) -> tuple:
    """Return the `(frr, srl)` output directories for a scenario."""
    root = resolve_scenario.output_dir(scenario) / "clab"
    return (root / "frr", root / "srl")


def short_name(name: str) -> str:
    """Return the interface's own short name for the description.

    FRR names are used as-is (`swp1`); SR Linux `ethernet-1/N` becomes `e1/N`.
    """
    if name.startswith("ethernet-"):
        return "e" + name[len("ethernet-") :]
    return name


def description(hostname: str, iface: dict) -> str:
    """Build the interface description: `<host>:<short> -> <to>`."""
    return f"{hostname}:{short_name(iface['name'])} -> {iface['to']}"


def render_frr(hostname: str, dev: dict) -> str:
    """Render an FRR `.iface` file body: `name|description` per line.

    Emits the loopback line first (`lo|<host> loopback`) when set.
    """
    lines = []
    loopback = dev.get("loopback")
    if loopback:
        lines.append(f"{loopback}|{hostname} loopback")
    lines.extend(f"{iface['name']}|{description(hostname, iface)}" for iface in dev["interfaces"])
    return "\n".join(lines) + "\n"


def render_srl(hostname: str, dev: dict) -> str:
    """Render an SR Linux `.cli` file body: two `set` lines per interface."""
    lines = []
    for iface in dev["interfaces"]:
        name = iface["name"]
        lines.append(f"set / interface {name} admin-state enable")
        lines.append(f'set / interface {name} description "{description(hostname, iface)}"')
    return "\n".join(lines) + "\n"


def _write(path: pathlib.Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content)


def _prune_stale(directory: pathlib.Path, suffix: str, keep: set) -> None:
    """Remove generated `*<suffix>` files for hostnames not in `keep`."""
    if not directory.is_dir():
        return
    for path in directory.glob(f"*{suffix}"):
        if path.stem not in keep:
            path.unlink()


def parse_args(argv: list) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Render the per-device interface configs for a scenario.")
    parser.add_argument("--scenario", help="scenario to render; defaults to $SCENARIO")
    return parser.parse_args(argv)


def main(argv: list | None = None) -> int:
    args = parse_args(sys.argv[1:] if argv is None else argv)
    scenario = resolve_scenario.scenario_name(args.scenario)
    devices = load_topology(scenario)
    frr_dir, srl_dir = device_dirs(scenario)

    frr_hosts = set()
    srl_hosts = set()

    for hostname, dev in devices.items():
        vendor = dev["vendor"]
        if vendor == "frr":
            _write(frr_dir / f"{hostname}.iface", render_frr(hostname, dev))
            frr_hosts.add(hostname)
        elif vendor == "srl":
            _write(srl_dir / f"{hostname}.cli", render_srl(hostname, dev))
            srl_hosts.add(hostname)
        else:
            print(f"unknown vendor {vendor!r} for {hostname}", file=sys.stderr)
            return 1

    _prune_stale(frr_dir, ".iface", frr_hosts)
    _prune_stale(srl_dir, ".cli", srl_hosts)

    print(f"generated {len(frr_hosts)} FRR + {len(srl_hosts)} SRL device configs")
    return 0


if __name__ == "__main__":
    sys.exit(main())
